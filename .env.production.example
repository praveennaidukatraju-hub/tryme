# ─── Postgres ────────────────────────────────────────────────
POSTGRES_USER=tryon
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=tryon_prod

DATABASE_URL=postgres://tryon:CHANGE_ME_STRONG_PASSWORD@tryme-prod-postgres:5432/tryon_prod

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://tryme-prod-redis:6379

# ─── Auth ────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING
COOKIE_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING
# JWT access token lifetime (default 15m). Increase only if you understand the risk.
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ─── Admin ───────────────────────────────────────────────────
# Seeds the first admin account on first boot. Remove after bootstrapping.
ADMIN_BOOTSTRAP_EMAIL=admin@yourdomain.com
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── CORS ────────────────────────────────────────────────────
# Browser origins allowed to call the API. Comma-separate multiple frontend hosts.
CORS_ORIGIN=https://app.tryme.com,https://admin.tryme.com
# Reverse proxies in front of the API. Production is Cloudflare -> nginx -> api.
# Too high lets a client spoof X-Forwarded-For and pick its own rate-limit bucket.
TRUST_PROXY_HOPS=2


# ─── Web / Email links ───────────────────────────────────────
# Public URL of the Next.js web app — used in verification and password reset emails.
WEB_URL=https://app.yourdomain.com

# ─── Cloudflare R2 ───────────────────────────────────────────
# S3-compatible endpoint for your R2 bucket (found in R2 → Overview → S3 API).
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your-bucket-name
# Public R2 URL or custom domain (no trailing slash)
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
# Set to false in production (true only for local MinIO which uses path-style URLs)
R2_FORCE_PATH_STYLE=false
# Optional: override the presigned-upload base URL seen by the browser.
# Leave blank to derive from R2_PUBLIC_URL. Set this if you proxy R2 through Nginx/CDN.
R2_PUBLIC_PRESIGN_BASE=
# Optional: override the endpoint used for presigned URL signing (SigV4 Host header).
# Required when MinIO is behind a reverse proxy that rewrites the Host header.
# Set this to your public domain (no /minio prefix), e.g. https://app.yourdomain.com
R2_SIGN_ENDPOINT=

# ─── Transactional Email (Resend) ────────────────────────────
# API key from resend.com → API Keys
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Must be a verified sender domain in Resend (e.g. noreply@yourdomain.com)
EMAIL_FROM=noreply@yourdomain.com

# ─── Google OAuth (optional) ─────────────────────────────────
# Leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized Redirect URI in Google Cloud Console.
GOOGLE_CALLBACK_URL=https://api.yourdomain.com/v1/auth/google/callback

# ─── ComfyUI Workers ─────────────────────────────────────────
# Comma-separated list of worker IDs matching the WORKER_<ID>_URL pattern below.
WORKER_IDS=worker-a,worker-b
# Default API key set in the Nginx reverse-proxy in front of each ComfyUI instance.
WORKER_API_KEY=CHANGE_ME_STRONG_RANDOM_STRING
# URL for each worker — add WORKER_B_URL etc. for additional workers.
WORKER_A_URL=https://worker-a.yourdomain.com
WORKER_B_URL=https://worker-b.yourdomain.com
# Per-worker key override (optional) — falls back to WORKER_API_KEY when a worker's
# Nginx instance uses a different key.
WORKER_B_API_KEY=CHANGE_ME_STRONG_RANDOM_STRING

# ─── Widget VPS (dedicated ComfyUI for widget try-on jobs) ───
# The VPS that runs the saree try-on workflow for merchant widget jobs.
# Auth is HTTP Basic Auth (not X-Api-Key) — "user:password" format.
WIDGET_COMFYUI_URL=https://CHANGE_ME_WIDGET_VPS_URL
WIDGET_COMFYUI_BASIC_AUTH=CHANGE_ME_USER:CHANGE_ME_PASSWORD

# ─── Web (baked into Next.js build) ─────────────────────────
# Public API base URL — must be reachable from the browser.
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
# Leave blank for root deployment. Set to e.g. /app for subdirectory deployment.
NEXT_PUBLIC_BASE_PATH=

# ─── Chatbot ─────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Google AI Studio key — used for the embedder (CHATBOT_EMBED_MODEL) and as the
# CHATBOT_GEN/TOOL_API_KEY fallback when provider=google
GOOGLE_API_KEY=
CHATBOT_PORT=4200
CHATBOT_SERVICE_TOKEN=CHANGE_ME_STRONG_RANDOM_STRING
# Server-side URL the api process uses to reach the chatbot service directly (admin ingest
# proxy). Distinct from NEXT_PUBLIC_CHATBOT_URL/VITE_CHATBOT_URL, which are browser-facing.
# Since api and chatbot are containers on the same tryme-net bridge network (see
# infra/docker-compose.prod.yml), use the container hostname — NOT the public domain —
# so this call stays inside the docker network instead of round-tripping through nginx.
CHATBOT_URL=http://chatbot:4200
NEXT_PUBLIC_CHATBOT_URL=https://chatbot.yourdomain.com
VITE_CHATBOT_URL=https://chatbot.yourdomain.com
# Embedding model for RAG (search + ingest). Requests 1536-dim output via
# outputDimensionality to match chatbot_embeddings.embedding's fixed vector(1536) column —
# see packages/db/src/schema/chatbot.ts.
CHATBOT_EMBED_MODEL=gemini-embedding-2-preview
CHATBOT_TOP_K=5
CHATBOT_SIMILARITY_THRESHOLD=0.4
CHATBOT_FALLBACK_LIMIT=2
CHATBOT_IDLE_TIMEOUT_MIN=30
CHATBOT_MAX_TOOL_ITERATIONS=4

# Generation model (writes the final reply)
CHATBOT_GEN_PROVIDER=anthropic
CHATBOT_GEN_MODEL=claude-haiku-4-5-20251001
CHATBOT_GEN_API_KEY=
CHATBOT_GEN_BASE_URL=
# ANTHROPIC_API_KEY is used as a fallback for CHATBOT_GEN_API_KEY when provider=anthropic

# Tool-calling (router) model — leave all CHATBOT_TOOL_* blank to reuse the
# generation model above for tool routing too.
CHATBOT_TOOL_PROVIDER=
CHATBOT_TOOL_MODEL=
CHATBOT_TOOL_API_KEY=
CHATBOT_TOOL_BASE_URL=
# Example split: strong model for generation, small local model for tool routing —
#   CHATBOT_TOOL_PROVIDER=openai-compatible
#   CHATBOT_TOOL_MODEL=qwen2.5:7b
#   CHATBOT_TOOL_API_KEY=ollama
#   CHATBOT_TOOL_BASE_URL=http://localhost:11434/v1

# ─── Razorpay ────────────────────────────────────────────────
# Key ID and Secret from Razorpay Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=CHANGE_ME
# Webhook secret from Razorpay Dashboard → Webhooks → your webhook → secret
# Subscribe to: payment.captured, payment.failed
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME

# ─── Sentry (error tracking) ─────────────────────────────────
# Create a project at sentry.io → Settings → Projects → DSN
# All three apps (api, dispatcher, web server) read SENTRY_DSN.
# The browser (web client) reads NEXT_PUBLIC_SENTRY_DSN separately.
SENTRY_DSN=https://your-key@oXXXXXX.ingest.sentry.io/XXXXXXX
NEXT_PUBLIC_SENTRY_DSN=https://your-key@oXXXXXX.ingest.sentry.io/XXXXXXX
# Source-map upload at build time (CI only). Get from sentry.io → Settings → Auth Tokens.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=tryme

# ─── Observability (Grafana Cloud, free tier) ───────────────
# Create a stack at grafana.com → "Connections / Details" page lists these.
# One Access Policy token with logs:write + metrics:write scopes is reused below.
# Loki push endpoint, e.g. https://logs-prod-012.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USER=
# Prometheus remote_write endpoint, e.g. https://prometheus-prod-01.grafana.net/api/prom/push
GRAFANA_CLOUD_PROM_URL=
GRAFANA_CLOUD_PROM_USER=
# Access Policy token (used as the basic-auth password for both Loki and Prometheus)
GRAFANA_CLOUD_API_KEY=

# ─── Shopify plugin ──────────────────────────────────────────
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://app.tryme.com   # OAuth redirect_uri + webhook callback base — must proxy /v1/shopify/* to api
SHOPIFY_SCOPES=read_products
SHOPIFY_TOKEN_ENC_KEY=            # openssl rand -base64 32
GOOGLE_DRIVE_TOKEN_ENC_KEY=       # openssl rand -base64 32 (optional, required for Google Drive export)
VITE_SHOPIFY_API_KEY=                # same value as SHOPIFY_API_KEY, exposed client-side for App Bridge
# Leave UNSET in production. Development stores always produce test one-time charges that Shopify
# never bills, so granting against them hands out credits (= GPU spend) for free — and any Partner
# can create dev stores without limit. Set to exactly `true` only on staging/dev, where it is the
# sole way to exercise the paid purchase flow. Only the literal 'true' enables it; 'false'/'0'/'no' all leave it off.
SHOPIFY_ALLOW_TEST_SUBSCRIPTIONS=
VITE_TRYME_APP_URL=https://app.tryme.com   # embedded admin's account-link popup target; override locally to an ngrok URL for testing
VITE_API_BASE_URL=https://app.tryme.com   # embedded admin SPA is served from admin.tryme.com, which doesn't proxy /v1/* — API calls must be absolute + cross-origin

# ─── Catalog Video (PixVerse) ────────────────────────────────
# Image-to-video generation. Runs on its own jobs:video Redis lane — no GPU worker
# involved — so VIDEO_CONCURRENCY is independent of the ComfyUI worker count.
# Set it to your PixVerse plan's concurrent-generation limit (starter = 5).
# Changing it requires a dispatcher restart.
PIXVERSE_API_KEY=
PIXVERSE_API_BASE_URL=https://app-api.pixverse.ai
PIXVERSE_POLL_INTERVAL_MS=5000
PIXVERSE_POLL_TIMEOUT_MS=180000
VIDEO_CONCURRENCY=5
