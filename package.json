{
  "name": "tryme",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm --filter './packages/*' -r run build && pnpm -r run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "pnpm -r run test",
    "test:ci-scripts": "vitest run --config vitest.config.ts",
    "ci:detect": "tsx scripts/ci/detect-affected.mts",
    "ci:check-migration-index": "tsx scripts/ci/check-migration-index.mts",
    "db:generate": "pnpm --filter @tryme/db run generate",
    "db:migrate": "pnpm --filter @tryme/db run migrate",
    "db:migrate:prod": "pnpm --filter @tryme/db run migrate:prod",
    "db:verify": "pnpm --filter @tryme/db run verify",
    "db:verify:prod": "pnpm --filter @tryme/db run verify:prod",
    "db:seed": "pnpm --filter @tryme/db run seed",
    "check:billing": "tsx --env-file=.env apps/api/scripts/check-billing-api-enabled.mts",
    "docker:up": "docker compose -f infra/docker-compose.yml --env-file .env up -d",
    "docker:down": "docker compose -f infra/docker-compose.yml --env-file .env down",
    "docker:logs": "docker compose -f infra/docker-compose.yml --env-file .env logs -f",
    "docker:reset": "docker compose -f infra/docker-compose.yml --env-file .env down -v",
    "docker:obs:up": "docker compose -f infra/docker-compose.yml --env-file .env --profile apps --profile observability up -d --build",
    "docker:obs:down": "docker compose -f infra/docker-compose.yml --env-file .env --profile apps --profile observability down",
    "backfill:thumbnails": "tsx --env-file=.env scripts/backfill-thumbnails.mts",
    "seed:contacts": "tsx --env-file=.env scripts/seed-contacts.ts",
    "seed:model-images": "tsx --env-file=.env scripts/seed-model-images.mts",
    "seed:garment-types": "tsx --env-file=.env scripts/seed-garment-types.mts",
    "seed:invoices": "tsx --env-file=.env scripts/seed-invoices.mts"
  },
  "devDependencies": {
    "@tryme/db": "workspace:*",
    "@tryme/storage": "workspace:*",
    "@aws-sdk/client-s3": "^3.673.0",
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^22.7.5",
    "eslint": "^10.6.0",
    "lefthook": "^2.1.8",
    "playwright": "^1.62.0",
    "sharp": "^0.33.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^2.1.3"
  }
}
