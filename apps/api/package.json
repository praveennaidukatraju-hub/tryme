{
  "name": "@tryme/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=../../.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'test/integration/**'",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "biome check src/",
    "postman:generate": "tsx --env-file=../../.env src/scripts/generate-postman.ts"
  },
  "dependencies": {
    "@tryme/db": "workspace:*",
    "@tryme/logger": "workspace:*",
    "@tryme/observability": "workspace:*",
    "@tryme/storage": "workspace:*",
    "@tryme/types": "workspace:*",
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/sensible": "^6.0.1",
    "@fastify/swagger": "^9.8.1",
    "@node-rs/argon2": "^2.0.2",
    "@scalar/fastify-api-reference": "^1.62.7",
    "@sentry/node": "^10.57.0",
    "adm-zip": "^0.5.17",
    "drizzle-orm": "^0.36.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "pdfkit": "^0.19.1",
    "resend": "^6.12.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1048.0",
    "@types/adm-zip": "^0.5.8",
    "@types/ioredis-mock": "^8.2.7",
    "@types/node": "^22.7.5",
    "@types/pdfkit": "^0.17.6",
    "dotenv": "^17.4.2",
    "ioredis-mock": "^8.13.1",
    "openapi-to-postmanv2": "^6.3.3",
    "postgres": "^3.4.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
