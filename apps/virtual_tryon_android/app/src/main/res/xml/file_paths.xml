<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path
        name="captured_photos"
        path="captured_photos/" />
    <!-- Covers cacheDir root, where camera_capture_*.jpg, fixed_*.jpg, edited_photo_*.jpg,
         and qr_downloaded_*.jpg are written — without this, FileProvider.getUriForFile()
         throws IllegalArgumentException for any of those files. -->
    <cache-path
        name="cache_root"
        path="." />
</paths>
